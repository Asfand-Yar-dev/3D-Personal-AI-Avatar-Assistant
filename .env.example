# Create a local .env file from this template and add your key. Never commit it.
MINIMAX_API_KEY=
# Optional. These defaults work with MiniMax's OpenAI-compatible chat API.
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
# Optional speech configuration. The app falls back to browser TTS if this API is unavailable for your key.
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=English_expressive_narrator
